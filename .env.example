# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NAO deve ser enviado ao GitHub (ja esta no .gitignore).

# Chave da API do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo do Gemini (opcional, padrao gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Porta do servidor Node.js (opcional, padrao 3000)
PORT=3000
